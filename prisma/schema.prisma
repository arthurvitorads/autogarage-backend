generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdmUsuario {
  cn_usuario      BigInt   @id @default(autoincrement()) @db.BigInt
  ca_id_firebase  String   @unique
  an_email        String
  an_nome         String
  cn_perfil       BigInt?  @db.BigInt
  bo_sts_reg      Boolean  @default(true)
  dt_inc          DateTime @default(now()) @db.Timestamptz(6)
  dt_alt          DateTime @default(now()) @db.Timestamptz(6)

  perfil AdmPerfil? @relation(fields: [cn_perfil], references: [cn_perfil], onDelete: Restrict, onUpdate: Cascade)

  @@index([cn_perfil], map: "idx_adm_usuario_3")
  @@map("adm_usuario")
}

model AdmPerfil {
  cn_perfil       BigInt   @id @default(autoincrement()) @db.BigInt
  an_descr        String
  bo_sts_reg      Boolean  @default(true)
  dt_inc          DateTime @default(now()) @db.Timestamptz(6)
  dt_alt          DateTime @default(now()) @db.Timestamptz(6)

  usuarios AdmUsuario[]

  @@map("adm_perfil")
}

model OrdClassificacaoOs {
  cn_classificacao_os BigInt   @id @default(autoincrement()) @db.BigInt @map("cn_status_os")
  an_descr        String
  ca_cor          String   @default("#64748b")
  bo_padrao       Boolean  @default(false)
  bo_sts_reg      Boolean  @default(true)
  dt_inc          DateTime @default(now()) @db.Timestamptz(6)
  dt_alt          DateTime @default(now()) @db.Timestamptz(6)

  ordens OrdOrdemServico[]

  @@map("ord_status_os")
}

model CadPessoa {
  cn_pessoa              BigInt   @id @default(autoincrement()) @db.BigInt
  ca_tipo                String   @db.Text
  an_nome                String?  @db.Text
  ca_cpf                 String?  @db.Text
  ca_cnpj                String?  @db.Text
  an_razao_social        String?  @db.Text
  an_nome_fantasia        String?  @db.Text
  an_email               String?  @db.Text
  an_telefone            String?  @db.Text
  bo_categ_cliente       Boolean  @default(true)
  bo_categ_func          Boolean  @default(false)
  an_cargo               String?  @db.Text
  nm_comissao_percentual Decimal? @default(0) @db.Decimal(5, 2)
  bo_sts_reg             Boolean  @default(true)
  dt_inc                 DateTime @default(now()) @db.Timestamptz(6)
  dt_alt                 DateTime @default(now()) @db.Timestamptz(6)

  endereco CadEndereco?
  ordens OrdOrdemServico[]

  @@index([dt_inc], map: "idx_cad_pessoa_3")
  @@map("cad_pessoa")
}

model CadProduto {
  cn_produto     Int      @id @default(autoincrement())
  an_nome        String
  an_referencia  String   @default("")
  an_categoria   String   @default("")
  an_marca       String   @default("")
  ca_unidade     String
  vl_custo       Decimal  @db.Decimal(11, 2)
  vl_venda       Decimal  @db.Decimal(11, 2)
  qt_estoque     Decimal  @db.Decimal(12, 3)
  qt_estoque_min Decimal  @db.Decimal(12, 3)
  an_obs         String   @default("")
  bo_sts_reg     Boolean  @default(true)
  dt_inc         DateTime @default(now()) @db.Timestamptz(6)
  dt_alt         DateTime @default(now()) @db.Timestamptz(6)
  itens OrdItemOs[]
  @@map("cad_produto")
}

model CadServico {
  cn_servico       Int      @id @default(autoincrement())
  an_nome          String
  an_categoria     String   @default("")
  vl_preco         Decimal  @db.Decimal(11, 2)
  nu_tempo_estimado Int?
  an_obs           String   @default("")
  bo_sts_reg       Boolean  @default(true)
  dt_inc           DateTime @default(now()) @db.Timestamptz(6)
  dt_alt           DateTime @default(now()) @db.Timestamptz(6)
  itens OrdItemOs[]
  @@map("cad_servico")
}

model CadAuxiliar {
  cn_cadastro Int      @id @default(autoincrement())
  ca_tipo     String
  an_descr    String
  ca_sigla    String   @default("")
  dt_inc      DateTime @default(now()) @db.Timestamptz(6)
  dt_alt      DateTime @default(now()) @db.Timestamptz(6)
  @@map("cad_auxiliar")
}

model OrdOrdemServico {
  cn_ordem_servico BigInt   @id @default(autoincrement()) @db.BigInt
  nu_numero        Int      @unique @default(autoincrement())
  cn_pessoa        BigInt   @db.BigInt
  cn_classificacao_os BigInt   @db.BigInt @map("cn_status_os")
  ca_status       String   @default("ABERTO")
  an_motivo_cancelamento String @default("")
  dt_inicio       DateTime? @db.Timestamptz(6)
  dt_finalizacao  DateTime? @db.Timestamptz(6)
  dt_cancelamento DateTime? @db.Timestamptz(6)
  dt_entrada       DateTime @db.Timestamptz(6)
  dt_previsao      DateTime? @db.Timestamptz(6)
  an_responsavel   String   @default("")
  an_placa         String
  an_marca         String
  an_modelo        String
  nu_ano           Int?
  an_cor           String   @default("")
  qt_quilometragem Int?
  an_solicitacao   String   @default("")
  an_obs           String   @default("")
  dt_inc           DateTime @default(now()) @db.Timestamptz(6)
  dt_alt           DateTime @default(now()) @db.Timestamptz(6)
  pessoa CadPessoa @relation(fields: [cn_pessoa], references: [cn_pessoa], onDelete: Restrict, onUpdate: Cascade, map: "fk_ord_ordem_servico_1")
  classificacao OrdClassificacaoOs @relation(fields: [cn_classificacao_os], references: [cn_classificacao_os], onDelete: Restrict, onUpdate: Cascade, map: "fk_ord_ordem_servico_2")
  itens OrdItemOs[]
  @@index([cn_pessoa], map: "idx_ord_ordem_servico_1")
  @@index([cn_classificacao_os], map: "idx_ord_ordem_servico_2")
  @@map("ord_ordem_servico")
}

model OrdItemOs {
  cn_item          BigInt   @id @default(autoincrement()) @db.BigInt
  cn_ordem_servico BigInt   @db.BigInt
  ca_tipo          String
  cn_produto       Int?
  cn_servico       Int?
  an_descr         String
  ca_unidade       String   @default("")
  qt_quantidade    Decimal  @db.Decimal(12, 3)
  vl_unitario      Decimal  @db.Decimal(11, 2)
  vl_total         Decimal  @db.Decimal(20, 2)
  dt_inc           DateTime @default(now()) @db.Timestamptz(6)
  dt_alt           DateTime @default(now()) @db.Timestamptz(6)
  ordem OrdOrdemServico @relation(fields: [cn_ordem_servico], references: [cn_ordem_servico], onDelete: Restrict, onUpdate: Cascade, map: "fk_ord_item_os_1")
  produto CadProduto? @relation(fields: [cn_produto], references: [cn_produto], onDelete: Restrict, onUpdate: Cascade, map: "fk_ord_item_os_2")
  servico CadServico? @relation(fields: [cn_servico], references: [cn_servico], onDelete: Restrict, onUpdate: Cascade, map: "fk_ord_item_os_3")
  @@index([cn_ordem_servico], map: "idx_ord_item_os_1")
  @@index([cn_produto], map: "idx_ord_item_os_2")
  @@index([cn_servico], map: "idx_ord_item_os_3")
  @@map("ord_item_os")
}

model CadEndereco {
  cn_endereco    BigInt   @id @default(autoincrement()) @db.BigInt
  cn_pessoa      BigInt   @unique(map: "idx_cad_endereco_1") @db.BigInt
  ca_cep         String?  @db.Text
  an_logradouro  String?  @db.Text
  an_numero      String?  @db.Text
  an_complemento String?  @db.Text
  an_bairro      String?  @db.Text
  an_cidade      String?  @db.Text
  ca_uf          String?  @db.Text
  bo_sts_reg     Boolean  @default(true)
  dt_inc         DateTime @default(now()) @db.Timestamptz(6)
  dt_alt         DateTime @default(now()) @db.Timestamptz(6)

  pessoa CadPessoa @relation(fields: [cn_pessoa], references: [cn_pessoa], onDelete: Restrict, onUpdate: Cascade, map: "fk_cad_endereco_1")

  @@index([dt_inc], map: "idx_cad_endereco_2")
  @@map("cad_endereco")
}


